# Copy to .env and fill in for production (see README.md "Production build").
# Not loaded automatically by the app — deploy/systemd/*.service reads this
# file directly via EnvironmentFile=. Never commit the real .env.

# Any long random string (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`).
# Must not be left as the dev default.
SECRET_KEY=

# Postgres only — SQLite is rejected outright in production.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# From a Google OAuth client — see README.md "Setting up Google sign-in".
# Only staff/admin sign in; students are anonymous (a share link + a cookie).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Selects ProdConfig (server/config.py) — also turns on SESSION_COOKIE_SECURE
# and forces the https URL scheme, so this must run behind HTTPS.
FLASK_ENV=production

# Only needed to launch for a different school/domain.
ALLOWED_EMAIL_DOMAIN=berkeley.edu

# Retention (server/services/retention.py, run daily by
# deploy/systemd/cs61a-retention.timer). Group work (code, answers,
# ratings) is snapshotted to a CSV then hard-deleted this many days after
# a group goes idle.
SESSION_DATA_TTL_DAYS=14
# Where the participation CSVs are written (must be writable by the `cs61a`
# user and survive deploys — keep it outside client/dist).
RETENTION_SNAPSHOT_DIR=/opt/cs61a-discussion/var/snapshots

# Optional: share the login rate limit across gunicorn workers. In-memory
# by default (fine for a single worker). Set to a Redis URL if you run
# several — nothing else needs Redis anymore.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Opt-in error monitoring — leave unset to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Only relevant if self-managing Postgres (deploy/scripts/backup_postgres.sh).
BACKUP_DIR=/var/backups/cs61a-discussion
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
