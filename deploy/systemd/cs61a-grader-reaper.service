[Unit]
Description=Reap orphaned CS61A grader containers
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=cs61a
Group=docker
WorkingDirectory=/opt/cs61a-discussion
ExecStart=/opt/cs61a-discussion/server/.venv/bin/python /opt/cs61a-discussion/deploy/scripts/reap_grader_containers.py
