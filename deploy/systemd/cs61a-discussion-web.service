[Unit]
Description=CS61A Discussion Viewer web app (gunicorn)
After=network.target

[Service]
Type=simple
User=cs61a
Group=cs61a
WorkingDirectory=/opt/cs61a-discussion
EnvironmentFile=/opt/cs61a-discussion/.env
Environment=FLASK_ENV=production
# Grading runs in the student's browser (Pyodide), so the web process
# never does heavy work — plain sync workers are plenty. Tune --workers to
# (2 x CPU cores) + 1 as a starting point.
ExecStart=/opt/cs61a-discussion/server/.venv/bin/gunicorn \
    --bind 0.0.0.0:8080 \
    --workers 4 \
    server.wsgi:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
